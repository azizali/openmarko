      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one decisive action in a view.",
      "html": "<button class=\"ds-btn-primary\">Save changes</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border-radius:8px;font:500 13.5px 'Roboto Flex',system-ui,sans-serif;white-space:nowrap;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s,opacity .15s,transform .15s;background:var(--ink);color:var(--on-ink);border:0;box-shadow:0 1px 2px rgb(0 0 0 / .03);}.ds-btn-primary:hover{opacity:.85;}.ds-btn-primary:active{transform:scale(.97);}.ds-btn-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}"
