{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.openmarko.com/api/:path*" },
    { "source": "/widget/:path*", "destination": "https://api.openmarko.com/widget/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
