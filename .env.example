# `bun run setup` writes .env from this file, with the secrets generated. Every variable is checked at boot (packages/kernel/src/config.ts):
# a bad value stops the process with a list of every problem, instead of failing on the first request.
# Comments sit on their own lines on purpose: some .env parsers read an inline "# ..." as part of the value.

# ===== Required =====

# development | test | production. Production adds the rules marked [prod].
NODE_ENV=development
# postgres:// or postgresql://. Local: the Docker Postgres from `bun run db:up`. Production: your Neon connection string.
DATABASE_URL=postgres://postgres:dev@localhost:5433/app
# 32+ characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Which MASTER_KEY_V<n> encrypts new secrets (ADR 0010).
MASTER_KEY_CURRENT=1
# 32 random bytes, base64: openssl rand -base64 32. When rotating, add MASTER_KEY_V2 and set MASTER_KEY_CURRENT=2.
MASTER_KEY_V1=

# ===== Addresses =====

# This API's own address. [prod: https]
BETTER_AUTH_URL=http://localhost:3000
# The web app: a trusted origin, and where emails link to. [prod: https]
APP_URL=http://localhost:5173
# The marketing site, if it calls the API (optional). [prod: https]
SITE_URL=
# Extra browser origins that may call the API with cookies, comma separated (optional).
TRUSTED_ORIGINS=
PORT=3000

# ===== People =====

# Comma list of emails that are app admins the moment they sign up (and existing accounts, at boot).
ADMIN_EMAILS=admin@example.test

# ===== Services: each turns itself on when its variables are set =====

# Google sign-in (both, or neither).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe, for the billing module. The webhook secret is needed to receive subscription webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cloudflare Turnstile, a visitor check before the chat widget starts a conversation (both, or neither).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== Development only =====

# bun test creates and drops a database per test file on this server.
# TEST_DATABASE_URL=postgres://postgres:dev@localhost:5433/postgres
# Password for the users scripts/seed.ts creates.
# SEED_PASSWORD=password-123
