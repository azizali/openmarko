# OpenMarko backend configuration. Every variable is checked at boot (packages/kernel/src/config.ts):
# a bad value stops the process with a list of every problem, instead of failing on the first request.
# Comments sit on their own lines on purpose: some .env parsers read an inline "# ..." as part of the value.

# ===== Required everywhere =====

# development | test | production. Production adds the rules marked [prod].
NODE_ENV=development
# postgres:// or postgresql://
DATABASE_URL=postgres://postgres:dev@localhost:5433/openmarko
# 32+ characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Which MASTER_KEY_V<n> encrypts new secrets (ADR 0010).
MASTER_KEY_CURRENT=1
# 32 random bytes, base64: openssl rand -base64 32. When rotating, add MASTER_KEY_V2 and set MASTER_KEY_CURRENT=2.
MASTER_KEY_V1=

# ===== Addresses =====

# This backend's own address. [prod: https]
BETTER_AUTH_URL=http://localhost:3000
# Comma list of frontend origins, e.g. https://app.example.com. [prod: required, https]
TRUSTED_ORIGINS=
PORT=3000

# ===== Modules and providers =====

ENABLED_MODULES=identity,organizations,access,features,settings,billing,integrations,automation,seo
# stub (default) or live, for every data provider (ADR 0013).
PROVIDERS=stub
# Comma list run live even when PROVIDERS=stub, e.g. dataforseo,gbp. Unknown names stop the boot.
PROVIDERS_LIVE=

# ===== Admin =====

# 32+ characters. Unset: /api/v1/admin/* refuses everything.
PLATFORM_ADMIN_TOKEN=

# ===== Optional: only when that integration is used =====

# sk_... for checkout. Stripe is never stubbed (ADR 0012).
STRIPE_SECRET_KEY=
# whsec_... for Stripe webhooks.
STRIPE_WEBHOOK_SECRET=
# Set both or neither. Required when gbp runs live (token refresh).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WEBHOOK_SECRET_<PROVIDER>: 16+ characters, signs /api/v1/webhooks/<provider>. Unset: that provider's webhooks are refused.
# WEBHOOK_SECRET_DATAFORSEO=

# Provider API keys are not environment variables: they are stored per Connection, encrypted (ADR 0010).

# ===== Development only =====

# bun test creates and drops a database per test file on this server.
# TEST_DATABASE_URL=postgres://postgres:dev@localhost:5433/postgres
# Password for the users scripts/seed.ts creates.
# SEED_PASSWORD=password-123
