{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun tooling/dev.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:worker": "bun --watch apps/worker/src/index.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:reset": "bun scripts/reset.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/seed.ts",
    "setup": "bun install --silent && bun tooling/setup.ts",
    "deploy:setup": "bun tooling/deploy-setup.ts",
    "admin:create": "bun scripts/create-admin.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json && tsc -p apps/site/tsconfig.json",
    "start:api": "bun apps/api/src/index.ts",
    "start:worker": "bun apps/worker/src/index.ts",
    "lint": "oxlint -c .oxlintrc.json apps modules packages scripts tooling app.config.ts",
    "format": "oxfmt --write apps modules packages scripts tooling app.config.ts",
    "format:check": "oxfmt --check apps modules packages scripts tooling app.config.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/openai": "4.0.102",
    "@better-auth/kysely-adapter": "1.7.14",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.16",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@app/access": "workspace:*",
    "@app/ai": "workspace:*",
    "@app/automation": "workspace:*",
    "@app/billing": "workspace:*",
    "@app/features": "workspace:*",
    "@app/identity": "workspace:*",
    "@app/integrations": "workspace:*",
    "@app/kernel": "workspace:*",
    "@app/knowledge": "workspace:*",
    "@app/messaging": "workspace:*",
    "@app/organizations": "workspace:*",
    "@app/partners": "workspace:*",
    "@app/server": "workspace:*",
    "@app/settings": "workspace:*",
    "@app/shared": "workspace:*",
    "@app/testkit": "workspace:*",
    "ai": "7.0.153",
    "better-auth": "1.7.14",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "kysely": "0.29.8",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
